# Copy this file to .env and fill in the required secrets.
# Never commit a real .env file.

# Optional compatibility backend; the default local_whisper backend needs no token.
REPLICATE_API_TOKEN=

# Optional: DeepSeek API key for the explicit cloud translation compatibility path.
SUBTRANS_DEEPSEEK_API_KEY=
# Optional compatibility fallback. Leave empty to use the local CPU translator.
DEEPSEEK_API_KEY=

# Paths and storage.
SUBTRANS_DATA_DIR=./data
SUBTRANS_DB=./data/db/app.db

# Background pipeline.
# Total tasks allowed to run through the pipeline. Keep this above the download cap
# so SRT generation can continue while other tasks wait for a download slot.
SUBTRANS_WORKERS=8

# Download settings.
SUBTRANS_DOWNLOAD_WORKERS=2
SUBTRANS_DL_CONCURRENT_FRAGMENTS=4
SUBTRANS_DL_FORMAT=bv*[height<=480]+ba/b[height<=480]
SUBTRANS_DL_CONTAINER=mp4
SUBTRANS_DL_RETRIES=3
# Optional cookies file for sites that require login or age verification.
SUBTRANS_COOKIES=
# Browser cookies are only used for an explicitly requested probe. Keep disabled
# unless the backend runs on the same trusted machine as the browser.
SUBTRANS_ALLOW_COOKIES_FROM_BROWSER=0
# Run the fixed ten-site availability probe once after each backend start.
SUBTRANS_STARTUP_PROBE_ENABLED=1

# FFmpeg tools.
SUBTRANS_FFMPEG=ffmpeg
SUBTRANS_FFPROBE=ffprobe
SUBTRANS_AUDIO_SR=16000
SUBTRANS_AUDIO_CH=1

# Transcriber settings.
# Select `local_whisper` (default), `replicate` (optional compatibility),
# or `http`/`custom` for a compatible service.
SUBTRANS_TRANSCRIBER_BACKEND=local_whisper
# Required when using a custom HTTP transcriber.
SUBTRANS_TRANSCRIBER_URL=
SUBTRANS_TRANSCRIBER_API_KEY=
SUBTRANS_TRANSCRIBER_TIMEOUT=1800
# Local OpenAI Whisper settings (used by local_whisper or transcriber_server).
SUBTRANS_LOCAL_WHISPER_MODEL=tiny
SUBTRANS_LOCAL_WHISPER_DEVICE=cpu
SUBTRANS_LOCAL_WHISPER_COMPUTE_TYPE=int8
# Optional directory for downloaded Hugging Face model files.
SUBTRANS_LOCAL_WHISPER_DOWNLOAD_ROOT=
SUBTRANS_LOCAL_WHISPER_BEAM_SIZE=5
# Legacy Replicate model setting; used only with SUBTRANS_TRANSCRIBER_BACKEND=replicate.
SUBTRANS_WHISPER_MODEL=stayallive/whisper-subtitles:b97ba81004e7132181864c885a76cae0e56bc61caa4190a395f6d8ba45b7a969
SUBTRANS_REPLICATE_TIMEOUT=1800
SUBTRANS_REPLICATE_RETRIES=3
SUBTRANS_REPLICATE_RETRY_INTERVAL=3600
SUBTRANS_REPLICATE_POLL_INTERVAL=30

# DeepSeek OpenAI-compatible API settings.
SUBTRANS_DEEPSEEK_BASE_URL=https://api.deepseek.com
SUBTRANS_DEEPSEEK_MODEL=deepseek-chat
SUBTRANS_TRANSLATE_BATCH=8
# 本地 CPU 翻译批量（与云端批量独立）
SUBTRANS_LOCAL_TRANSLATE_BATCH=16
SUBTRANS_TRANSLATE_TIMEOUT=60
